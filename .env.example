# Required to use the admin menu (⚙️). Pick a long random string.
ADMIN_TOKEN=change-me

# Optional first-run starting points: OpenAI-compatible base URLs (no trailing /v1). Leave any blank and
# add it later in the admin menu. Everything is changeable there, with fallback tiers (T1 -> T2 -> T3).
CHAT_URL=
CHAT_MODEL=
EMBED_URL=            # separate from chat; defaults to CHAT_URL if blank
EMBED_MODEL=
STT_URL=
STT_MODEL=
TTS_URL=              # optional; without it the UI uses the browser's built-in voice
TTS_MODEL=
TTS_VOICE=

MEM_BACKEND=mem0      # mem0 (vendored) | file
DEFAULT_BOOK=demo
