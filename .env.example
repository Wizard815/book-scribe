# --- logins (one writer account per container, plus the admin) -------------------------------------------------------------
# Admin: signs in at /admin.html with ADMIN_USER and ADMIN_TOKEN as the password. Needs 16+ random characters, e.g. `openssl rand -hex 24`.
# Weak or empty = no admin login at all.
ADMIN_USER=admin
ADMIN_TOKEN=
# Writer: the admin creates the writer's username and password in the admin panel. Optionally seed it here for the first start
# (password 8+ characters). After that, changes are made in the app or the admin panel and these two lines are ignored.
WRITER_USERNAME=
WRITER_PASSWORD=
# Set to 1 only when everything reaches this container through your own tunnel/proxy (uses CF-Connecting-IP / X-Forwarded-For
# for the "too many wrong tries" limit).
TRUST_PROXY=

# Optional first-run starting points: OpenAI-compatible base URLs (no trailing /v1). Leave any blank and
# add it later in the admin menu. Everything is changeable there, with fallback tiers (T1 -> T2 -> T3).
CHAT_URL=
CHAT_MODEL=
EMBED_URL=            # separate from chat; defaults to CHAT_URL if blank
EMBED_MODEL=
STT_URL=
STT_MODEL=
TTS_URL=              # optional; without it the UI uses the browser's built-in voice
TTS_MODEL=
TTS_VOICE=

MEM_BACKEND=mem0      # mem0 (vendored) | file
DEFAULT_BOOK=demo
