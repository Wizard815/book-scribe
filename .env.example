# Required to use the admin menu (model/provider settings). Pick a long random string.
ADMIN_TOKEN=change-me

# First-run defaults for the "local" providers. After that, manage everything from the admin menu
# (stored in data/books/.state/providers.json). Base URLs, no trailing /v1.
LLAMA_SWAP_URL=http://UNRAID_IP:8080
LLM_MODEL=default
EMBED_MODEL=embed
WHISPER_URL=http://UNRAID_IP:8000
# TTS_URL=http://UNRAID_IP:8000     # optional; without it the UI uses the browser's built-in voice

MEM_BACKEND=mem0        # mem0 (vendored) | file
DEFAULT_BOOK=demo
