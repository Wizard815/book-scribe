# --- logins (one writer account per container, plus the admin) -------------------------------------------------------------
# Admin: signs in at /admin.html with ADMIN_USER and ADMIN_TOKEN as the password. Needs 16+ random characters, e.g. `openssl rand -hex 24`.
# Weak or empty = no admin login at all.
ADMIN_USER=admin
ADMIN_TOKEN=
# Writer: the admin creates the writer's username and password in the admin panel. Optionally seed it here for the first start
# (password 8+ characters). After that, changes are made in the app or the admin panel and these two lines are ignored.
WRITER_USERNAME=
WRITER_PASSWORD=
# Set to 1 only when everything reaches this container through your own tunnel/proxy (uses CF-Connecting-IP / X-Forwarded-For
# for the "too many wrong tries" limit).
TRUST_PROXY=

# Optional first-run starting points: OpenAI-compatible base URLs (no trailing /v1). Leave any blank and
# add it later in the admin menu. Everything is changeable there, with fallback tiers (T1 -> T2 -> T3).
CHAT_URL=
CHAT_MODEL=
EMBED_URL=            # separate from chat; defaults to CHAT_URL if blank
EMBED_MODEL=
STT_URL=
STT_MODEL=
TTS_URL=              # optional; without it the UI uses the browser's built-in voice
TTS_MODEL=
TTS_VOICE=

MEM_BACKEND=mem0      # mem0 (vendored) | file
DEFAULT_BOOK=demo

# --- files, folders, memory ---------------------------------------------------------------------------------
# Each book has an inbox folder: put files in data/books/<book>/inbox and the agent notices them and asks to add them.
HOST_BOOKS_PATH=      # where ./data/books is on your computer, so the app can show you the real folder path (optional)
FILE_SEARCH_DIRS=     # folders (inside the container, ":"-separated) the agent may search for a file you describe, e.g. /downloads
ADDONS_DIR=           # folder of your own addon .py files, e.g. /addons
CONTEXT_CHARS=9000    # how much recent conversation is kept word for word; older talk is summarised automatically
SEARXNG_URL=          # optional web search, e.g. http://searxng:8080 (enable the json format in SearXNG's settings.yml)
WIKIPEDIA_URL=        # optional, e.g. https://en.wikipedia.org or an offline Kiwix mirror; leave blank to keep the agent offline
IMAGE_URL=            # optional picture maker: an OpenAI-compatible /v1/images/generations server (base URL)
IMAGE_MODEL=
